# Local dev / user image (normal Python, not Lambda)
FROM python:3.11-slim

# System deps for plotting, RDKit-related stuff, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    libcairo2-dev \
    libpango1.0-dev \
    libffi-dev \
    libssl-dev \
    libgl1 \
 && rm -rf /var/lib/apt/lists/*

# Set workdir
WORKDIR /app

# Copy requirements first (for better Docker cache)
COPY requirements.txt /app/requirements.txt

# Install Python deps
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy the rest of the repo
COPY . /app

# Environment similar to Lambda, but adapted for local
ENV TMPDIR=/tmp \
    PROPS_ROOT=/app/docs/library \
    PROPS_SUBDIR=properties \
    PROPS_S3_BUCKET= \
    PROPS_S3_PREFIX= \
    PLOT_S3_BUCKET= \
    AWS_REGION=us-east-1 \
    FRONTEND_CDN=http://localhost:8000

# Expose FastAPI port
EXPOSE 8000

# Run FastAPI directly with uvicorn
# backend.app:app -> this is your FastAPI instance in backend/app.py
CMD ["uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]
